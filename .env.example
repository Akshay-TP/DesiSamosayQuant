# Roostoo competition account
ROOSTOO_API_KEY=replace_me
ROOSTOO_API_SECRET=replace_me
ROOSTOO_BASE_URL=https://mock-api.roostoo.com

# Bot operation. Market orders are sent when DRY_RUN=false.
DRY_RUN=false
POLL_SECONDS=3600
REBALANCE_HOURS=4

# Risk and execution limits
MAX_EXPOSURE=0.75
MAX_POSITION_WEIGHT=0.25
MAX_DRAWDOWN_PCT=0.08
MAX_DAILY_LOSS_PCT=0.04
MIN_TRADE_USD=250
MAX_ORDER_USD=25000
TAKER_FEE_RATE=0.001

# Universe is filtered against pairs currently enabled by Roostoo.
TRADING_PAIRS=BTC/USD,ETH/USD,BNB/USD,SOL/USD,XRP/USD,LINK/USD,DOGE/USD,AVAX/USD,LTC/USD,TRX/USD

# Public Binance candles seed momentum history at startup; live signals use Roostoo prices.
BOOTSTRAP_BINANCE=true
BINANCE_BASE_URL=https://api.binance.com
HISTORY_HOURS=168
DATA_DIR=runtime
